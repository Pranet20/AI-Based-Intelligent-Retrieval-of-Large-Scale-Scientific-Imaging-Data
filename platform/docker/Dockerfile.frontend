# ====================================================================
# Multi-Stage Production Dockerfile for SciData Frontend
# ====================================================================

# Stage 1: Build production React static assets
FROM node:18-alpine AS build

WORKDIR /app

# Install dependencies
COPY platform/frontend/package.json ./
RUN npm install

# Build static bundle
COPY platform/frontend/ ./
ENV CI=false
RUN npm run build

# Stage 2: Serve via hardened Nginx Alpine
FROM nginx:1.25-alpine

# Copy custom Nginx configuration
COPY platform/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy production build artifacts from builder stage
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
