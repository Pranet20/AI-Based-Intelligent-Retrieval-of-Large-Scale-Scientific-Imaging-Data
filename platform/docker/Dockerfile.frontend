FROM node:20-alpine AS build

WORKDIR /app

COPY platform/frontend/package.json ./
RUN npm install

COPY platform/frontend ./
RUN npx tsc || true

FROM nginx:alpine

COPY platform/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY platform/frontend/public /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
