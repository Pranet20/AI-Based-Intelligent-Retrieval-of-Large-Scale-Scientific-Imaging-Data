FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for libgl and scientific image decoding
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user and group
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -s /bin/sh -m appuser

# Install python dependencies
COPY platform/backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application, frozen models, data, and core libraries
COPY platform/backend/app /app/app
COPY src /app/src
COPY configs /app/configs
COPY data /app/data

# Create storage hierarchy and grant ownership to appuser
RUN mkdir -p /app/platform/storage/originals /app/platform/storage/thumbnails /app/platform/storage/indexes && \
    chmod -R 777 /app/platform/storage && \
    chown -R appuser:appuser /app

ENV PYTHONPATH="/app:/app/app"

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
