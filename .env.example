# SciData Platform Environment Configuration Template
# Copy this file to .env and customize values for production deployment

# Environment & Testing
ENVIRONMENT=production
TESTING=false

# PostgreSQL Database Configuration
POSTGRES_DB=scidata_platform
POSTGRES_USER=scidata_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_PORT=5432

# Application Database Connection URL
# For Docker Compose networked setup:
DATABASE_URL=postgresql+psycopg2://scidata_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/scidata_platform
# For Local Host PostgreSQL setup:
# DATABASE_URL=postgresql+psycopg2://scidata_user:CHANGE_ME_SECURE_PASSWORD@127.0.0.1:5432/scidata_platform
# For Local SQLite testing:
# DATABASE_URL=sqlite:///./platform/storage/scidata_platform.db

# Security & Authentication (minimum 32 random characters in production)
SECRET_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_MIN_32_CHAR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Paths
BASE_STORAGE_PATH=platform/storage
ORIGINALS_PATH=platform/storage/originals
THUMBNAILS_PATH=platform/storage/thumbnails
INDEXES_PATH=platform/storage/indexes
STORAGE_BACKEND_TYPE=LOCAL

# Authoritative Pinned Model Artifacts
DINOV2_MODEL_NAME=dinov2_vits14
DINOV2_EMBEDDING_DIM=384
PHASE4_CHECKPOINT_PATH=data/processed/phase4/checkpoints/best_checkpoint_seed42.pt
EXPECTED_PHASE4_HASH=53ba60a317a140ceaebdf2e152dea88fd78f2a8bffbec378fc14c84010fd0e62

# Preprocessing & Limits
PREPROCESSING_VERSION=1.0.0
IMAGE_TARGET_SIZE=224
MAX_UPLOAD_SIZE_BYTES=52428800
